+// ---- KSD input-trust: four-tier admission ladder (docs/law/input-trust.md) ----
+// Each device is classified into exactly one tier at enumeration, before it is
+// admitted to the seat. Tier 0/1/3 are decided from bustype + VID:PID. Tier 2
+// (proven) is the crypto-proven remote; the follow-on "harden" slice wires the
+// per-device kidulKey challenge (input-path.draft.md §Two-phase plan). The
+// "dangerous class" reject arm of the ladder lives in the USB guard below us
+// (mass-storage/smartcard/net never reach libinput as input devices), so a
+// malicious HID "keyboard" that slips the guard still lands Tier 3 UNTRUSTED —
+// it types and navigates but never touches a harmful bind.
+
+static bool ksd_bustype_is_internal(int bustype) {
+	// The box's own hardware: AT keyboard, touchpad, lid/power buttons, iGPU,
+	// HDA audio. Kernel-standard bus signals — no allowlist, no proof.
+	switch (bustype) {
+	case BUS_I8042:
+	case BUS_HOST:
+	case BUS_PCI:
+	case BUS_INTEL_ISHTP:
+	case BUS_I2C:
+	case BUS_SPI:
+	case BUS_ISA:
+	case BUS_ISAPNP:
+	case BUS_RMI:
+	case BUS_CEC:
+	case BUS_AMD_SFH:
+	case BUS_SDW:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool ksd_vidpid_in_allowlist(int vendor, int product) {
+	// /etc/kushd/input-allowlist — one `vid:pid` per line (hex, no 0x),
+	// optional trailing name, `#` comments. Tier 1: known external devices
+	// (Planck 03a8:a4f9, the remote, ...). Identity is spoofable, so this tier
+	// grants USABLE (type/navigate), never harmful binds.
+	const char *path = "/etc/kushd/input-allowlist";
+	FILE *f = fopen(path, "r");
+	if (!f) {
+		return false;
+	}
+	char line[256];
+	bool found = false;
+	while (fgets(line, sizeof(line), f)) {
+		if (line[0] == '#') {
+			continue;
+		}
+		unsigned int v = 0, p = 0;
+		if (sscanf(line, "%x:%x", &v, &p) == 2 &&
+				(int)v == vendor && (int)p == product) {
+			found = true;
+			break;
+		}
+	}
+	fclose(f);
+	return found;
+}
+
+static const char *ksd_trust_name(enum wlr_libinput_trust t) {
+	switch (t) {
+	case WLR_LIBINPUT_TRUST_INTERNAL: return "internal";
+	case WLR_LIBINPUT_TRUST_USABLE: return "usable";
+	case WLR_LIBINPUT_TRUST_PROVEN: return "proven";
+	case WLR_LIBINPUT_TRUST_UNTRUSTED: return "untrusted";
+	}
+	return "untrusted";
+}
+
+static enum wlr_libinput_trust ksd_classify_device(
+		struct libinput_device *libinput_dev) {
+	int bustype = libinput_device_get_id_bustype(libinput_dev);
+	int vendor = libinput_device_get_id_vendor(libinput_dev);
+	int product = libinput_device_get_id_product(libinput_dev);
+
+	if (ksd_bustype_is_internal(bustype)) {
+		return WLR_LIBINPUT_TRUST_INTERNAL;
+	}
+	if (ksd_vidpid_in_allowlist(vendor, product)) {
+		return WLR_LIBINPUT_TRUST_USABLE;
+	}
+	// Tier 2 (proven) is the crypto-proven remote — no per-device proof is
+	// wired yet, so no device lands here on this build. Deliberately NOT read
+	// from the global /run/kushd/input-trust verdict: that proves the SEAT
+	// (kidulKey dongle tap), not THIS device — promoting every device on a
+	// trusted seat would re-open the "first keyboard wins" hole the ladder
+	// exists to close.
+	return WLR_LIBINPUT_TRUST_UNTRUSTED;
+}
+
 static void handle_device_added(struct wlr_libinput_backend *backend,
 		struct libinput_device *libinput_dev) {
 	int vendor = libinput_device_get_id_vendor(libinput_dev);
@@ -68,12 +161,18 @@ static void handle_device_added(struct wlr_libinput_backend *backend,
 	const char *name = libinput_device_get_name(libinput_dev);
 	wlr_log(WLR_DEBUG, "Adding %s [%d:%d]", name, vendor, product);
 
+	// KSD input-trust: classify + admit BEFORE the device is created.
+	enum wlr_libinput_trust trust = ksd_classify_device(libinput_dev);
+	wlr_log(WLR_INFO, "[input-trust] %s [%04x:%04x] tier=%d %s", name,
+		vendor, product, (int)trust, ksd_trust_name(trust));
+
 	struct wlr_libinput_input_device *dev = calloc(1, sizeof(*dev));
 	if (dev == NULL) {
 		wlr_log_errno(WLR_ERROR, "failed to allocate wlr_libinput_input_device");
 		return;
 	}
 
+	dev->trust = trust;
 	dev->handle = libinput_dev;
 	libinput_device_ref(libinput_dev);
 	libinput_device_set_user_data(libinput_dev, dev);
