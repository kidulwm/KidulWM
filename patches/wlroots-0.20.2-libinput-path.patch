+// KSD input-trust: the four-tier admission ladder (docs/law/input-trust.md).
+// A device is classified into exactly one tier at enumeration, BEFORE it is
+// admitted to the seat. The tier gates what the compositor lets the device do
+// (harmful binds live only for INTERNAL + PROVEN).
+enum wlr_libinput_trust {
+	WLR_LIBINPUT_TRUST_INTERNAL = 0,  // tier 0 — the box itself (internal bus)
+	WLR_LIBINPUT_TRUST_USABLE = 1,    // tier 1 — known external (allowlisted VID:PID)
+	WLR_LIBINPUT_TRUST_PROVEN = 2,    // tier 2 — crypto-proven remote (kidulKey challenge)
+	WLR_LIBINPUT_TRUST_UNTRUSTED = 3, // tier 3 — unknown
+};
