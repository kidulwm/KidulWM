#!/usr/bin/env python3
"""rkt-email-view — open a terminal summary of the configured IMAP inbox."""
import argparse
import imaplib
import json
import os
import ssl
import subprocess
import sys
from pathlib import Path


def default_config_path() -> Path:
    env = os.environ.get("RKT_EMAIL_CONFIG")
    if env:
        return Path(env)
    env_dir = os.environ.get("RKT_DASHBOARD_CONFIG_DIR")
    if env_dir:
        return Path(env_dir) / "email.json"
    return Path.home() / ".config" / "rkt-dashboard" / "email.json"


def unread_count(config: dict) -> int:
    c = imaplib.IMAP4(config["imap"]["host"], config["imap"]["port"])
    c.starttls(ssl._create_unverified_context())
    c.login(config["imap"]["user"], config["imap"]["pass"])
    c.select("INBOX", readonly=True)
    _, data = c.search(None, "UNSEEN")
    count = len(data[0].split())
    c.logout()
    return count


def main():
    parser = argparse.ArgumentParser(description="Terminal email summary for rkt-dashboard")
    parser.add_argument("--config", type=Path, default=default_config_path())
    parser.add_argument("--sync-command", default=None, help="command to sync mail before reading")
    parser.add_argument("--list-command", default=None, help="command to list recent mail")
    args = parser.parse_args()

    if not args.config.exists():
        print(f"No email config at {args.config}", file=sys.stderr)
        sys.exit(1)

    config = json.loads(args.config.read_text())

    sync_cmd = args.sync_command or config.get("sync_command")
    if sync_cmd:
        print("Syncing mail…")
        try:
            subprocess.run(sync_cmd, shell=True, check=True)
        except subprocess.CalledProcessError as e:
            print(f"Sync failed: {e}", file=sys.stderr)

    try:
        n = unread_count(config)
    except Exception as e:
        print(f"Unread query failed: {e}", file=sys.stderr)
        n = -1

    print(f"\nUnread: {n if n >= 0 else '?'}")

    list_cmd = args.list_command or config.get("list_command")
    if list_cmd:
        print("\nRecent mail:")
        try:
            subprocess.run(list_cmd, shell=True, check=True)
        except subprocess.CalledProcessError as e:
            print(f"List failed: {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
