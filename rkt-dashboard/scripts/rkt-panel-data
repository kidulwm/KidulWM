#!/usr/bin/env python3
"""rkt-panel-data — feed live info into the RKT right-hand panel.

Outputs a single JSON object with:
  - weather (current + forecast + alerts)
  - rss (latest headlines from configured feeds)
  - email (unread count from local ProtonMail Bridge via IMAP)
  - backup (days since last external backup)

Cache lives in ~/.cache/rkt-dashboard/panel-data.json and is refreshed based on
section TTLs. Stderr is reserved for diagnostics; stdout is always valid JSON.
"""

import datetime
import email.utils
import html
import imaplib
import json
import os
import ssl
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path


CONFIG_DIR = Path.home() / ".config" / "rkt-dashboard"
CACHE_DIR = Path.home() / ".cache" / "rkt-dashboard"
CACHE_FILE = CACHE_DIR / "panel-data.json"
FEEDS_FILE = CONFIG_DIR / "feeds.json"
WEATHER_FILE = CONFIG_DIR / "weather.json"
BOBMAIL_CONFIG = Path.home() / ".config" / "bobmail" / "config.json"
BACKUP_ROOT = Path("/mnt/sda_backup/hermes-backups")


def now_ts() -> str:
    return datetime.datetime.now().isoformat()


def load_json(path: Path, default=None):
    if path.exists():
        try:
            return json.loads(path.read_text())
        except Exception:
            pass
    return default if default is not None else {}


def fetch_url(url: str, timeout: int = 20) -> bytes:
    req = urllib.request.Request(url, headers={"User-Agent": "rkt-panel-data/1.0"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


def parse_date(text: str) -> datetime.datetime:
    """Parse RSS/Atom date strings; fall back to now."""
    if not text:
        return datetime.datetime.now()
    try:
        ts = email.utils.parsedate_to_datetime(text)
        if ts.tzinfo is None:
            return ts.replace(tzinfo=datetime.timezone.utc)
        return ts.astimezone(datetime.timezone.utc)
    except Exception:
        try:
            return datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))
        except Exception:
            return datetime.datetime.now()


def parse_feed(url: str) -> list:
    items = []
    try:
        data = fetch_url(url)
        root = ET.fromstring(data)
        channel = root.find("channel")
        if channel is not None:
            for item in channel.findall("item"):
                title = item.findtext("title", "").strip()
                link = item.findtext("link", "").strip()
                pub = item.findtext("pubDate", "")
                items.append({
                    "title": html.unescape(title),
                    "link": link,
                    "source": url,
                    "ts": parse_date(pub).isoformat(),
                })
        else:
            ns = {"atom": "http://www.w3.org/2005/Atom"}
            for entry in root.findall("atom:entry", ns):
                title = entry.findtext("atom:title", "", ns).strip()
                link_el = entry.find("atom:link", ns)
                link = link_el.attrib.get("href", "") if link_el is not None else ""
                pub = entry.findtext("atom:updated", "", ns) or entry.findtext("atom:published", "", ns)
                items.append({
                    "title": html.unescape(title),
                    "link": link,
                    "source": url,
                    "ts": parse_date(pub).isoformat(),
                })
    except Exception as e:
        items.append({
            "title": f"feed error: {url}",
            "link": "",
            "source": url,
            "ts": now_ts(),
            "error": str(e),
        })
    return items


def get_rss() -> dict:
    default_feeds = [
        {"name": "Arch Linux", "url": "https://archlinux.org/feeds/news/"},
        {"name": "CachyOS", "url": "https://cachyos.org/rss.xml"},
        {"name": "Niri", "url": "https://github.com/niri-wm/niri/releases.atom"},
        {"name": "Noctalia", "url": "https://github.com/noctalia-dev/noctalia-shell/releases.atom"},
        {"name": "Linux Kernel", "url": "https://www.kernel.org/feeds/kdist.xml"},
        {"name": "Zig", "url": "https://ziglang.org/news/index.xml"},
        {"name": "Ghostty", "url": "https://github.com/ghostty-org/ghostty/releases.atom"},
        {"name": "KidulWM", "url": "https://github.com/kidulwm/KidulWM/releases.atom"},
    ]
    feeds = load_json(FEEDS_FILE, {"feeds": default_feeds}).get("feeds", default_feeds)
    all_items = []
    for feed in feeds:
        for item in parse_feed(feed["url"]):
            item["feed_name"] = feed.get("name", feed["url"])
            all_items.append(item)
    all_items.sort(key=lambda x: x.get("ts", ""), reverse=True)
    return {
        "items": all_items[:20],
        "last_fetch": now_ts(),
    }


def get_weather(cfg: dict) -> dict:
    location = cfg.get("location", "Brisbane")
    severe_keywords = ["storm", "flood", "cyclone", "tornado", "hail", "severe", "extreme", "thunder", "bushfire", "fire warning"]
    try:
        url = f"https://wttr.in/{urllib.parse.quote(location)}?format=j1"
        data = json.loads(fetch_url(url, timeout=15))
        current = data.get("current_condition", [{}])[0]
        area = data.get("nearest_area", [{}])[0]
        resolved = area.get("areaName", [{}])[0].get("value", location)
        forecast = []
        for day in data.get("weather", [])[:3]:
            forecast.append({
                "date": day.get("date", ""),
                "max_c": int(day.get("maxtempC", 0)),
                "min_c": int(day.get("mintempC", 0)),
                "condition": day.get("hourly", [{}])[0].get("weatherDesc", [{}])[0].get("value", ""),
            })
        temp_c = int(current.get("temp_C", 0))
        condition = current.get("weatherDesc", [{}])[0].get("value", "")
        alerts = []
        if temp_c >= 35:
            alerts.append({"severity": "high", "text": f"Hot: {temp_c}°C forecast"})
        if any(k in condition.lower() for k in severe_keywords):
            alerts.append({"severity": "warn", "text": condition})
        for f in forecast:
            if f["max_c"] >= 35:
                alerts.append({"severity": "warn", "text": f"{f['date']} hot: {f['max_c']}°C"})
            if any(k in f["condition"].lower() for k in severe_keywords):
                alerts.append({"severity": "warn", "text": f"{f['date']}: {f['condition']}"})
        return {
            "location": resolved,
            "current_temp_c": temp_c,
            "condition": condition,
            "humidity": int(current.get("humidity", 0)),
            "wind_kph": int(current.get("windspeedKmph", 0)),
            "forecast": forecast,
            "alerts": alerts,
            "last_fetch": now_ts(),
        }
    except Exception as e:
        return {
            "location": location,
            "current_temp_c": 0,
            "condition": "unavailable",
            "humidity": 0,
            "wind_kph": 0,
            "forecast": [],
            "alerts": [],
            "error": str(e),
            "last_fetch": now_ts(),
        }


def get_email_unseen() -> dict:
    cfg = load_json(BOBMAIL_CONFIG, {})
    imap = cfg.get("imap")
    if not imap:
        return {"unread": -1, "error": "no bobmail imap config", "last_sync": now_ts()}
    try:
        ctx = ssl._create_unverified_context()
        c = imaplib.IMAP4(imap["host"], imap["port"])
        c.starttls(ctx)
        c.login(imap["user"], imap["pass"])
        c.select("INBOX", readonly=True)
        _, data = c.search(None, "UNSEEN")
        unseen = len([n for n in data[0].split() if n])
        c.logout()
        return {"unread": unseen, "last_sync": now_ts()}
    except Exception as e:
        return {"unread": -1, "error": str(e), "last_sync": now_ts()}


def get_backup() -> dict:
    if not BACKUP_ROOT.exists():
        return {"days_since": -1, "status": "unknown", "last_backup": "", "last_check": now_ts()}
    try:
        dirs = sorted(
            [p for p in BACKUP_ROOT.iterdir() if p.is_dir()],
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )
        if not dirs:
            return {"days_since": -1, "status": "unknown", "last_backup": "", "last_check": now_ts()}
        latest = dirs[0]
        mtime = latest.stat().st_mtime
        last_dt = datetime.datetime.fromtimestamp(mtime)
        days = (datetime.datetime.now() - last_dt).days
        status = "ok" if days <= 2 else "warn" if days <= 7 else "alert"
        return {
            "days_since": days,
            "status": status,
            "last_backup": last_dt.isoformat(),
            "path": str(latest),
            "last_check": now_ts(),
        }
    except Exception as e:
        return {"days_since": -1, "status": "error", "error": str(e), "last_check": now_ts()}


def main():
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)

    cache = load_json(CACHE_FILE, {})
    now = time.time()

    ttl_map = {
        "weather": 900,   # 15 min
        "rss": 1800,      # 30 min
        "email": 120,     # 2 min
        "backup": 3600,   # 1 hour
    }

    result = {}
    for section, ttl in ttl_map.items():
        cached = cache.get(section, {})
        fetched_at = cached.get("last_fetch") or cached.get("last_sync") or cached.get("last_check")
        try:
            age = now - datetime.datetime.fromisoformat(fetched_at).timestamp() if fetched_at else 999999
        except Exception:
            age = 999999

        if age < ttl:
            result[section] = cached
            continue

        if section == "weather":
            cfg = load_json(WEATHER_FILE, {})
            result[section] = get_weather(cfg)
        elif section == "rss":
            result[section] = get_rss()
        elif section == "email":
            result[section] = get_email_unseen()
        elif section == "backup":
            result[section] = get_backup()

    cache.update(result)
    CACHE_FILE.write_text(json.dumps(cache, indent=2))
    print(json.dumps(result))


if __name__ == "__main__":
    main()
